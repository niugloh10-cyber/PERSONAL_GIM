{
  "name": "sistema-gim-v4",
  "version": "4.1.0",
  "description": "Sistema GIM v4.1 - Arquitectura Modular Empresarial - GIM/MPP",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "importar-bd": "node importar_bd.js BD_2025_Y_2026_.xlsm",
    "build:exe": "pkg . --targets node18-win-x64 --output sistema-gim-v4.exe"
  },
  "author": "GIM - Municipalidad Provincial de Puno",
  "license": "MIT",
  "pkg": {
    "scripts": [
      "backend/server.js",
      "backend/modules/**/*.js",
      "backend/lib/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "plantillas/**/*",
      "backend/lib/**/*",
      "backend/routes/**/*",
      "backend/services/**/*",
      "backend/middleware/**/*",
      "backend/modules/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "jsdom": "^29.1.1",
    "multer": "^1.4.5-lts.1",
    "pizzip": "^3.1.6"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "keywords": [
    "RBAC",
    "modular",
    "GIM",
    "municipalidad",
    "v4",
    "expediente-digital"
  ]
}
